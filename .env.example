# Optional: set this to the exact public URL after deploying (no trailing slash).
# Example: NEXT_PUBLIC_SITE_URL=https://your-real-domain.com
# Leave unset for local development and preview deployments to keep indexing disabled.

# Optional Google AdSense settings. Keep unset until the site is approved by AdSense.
# Publisher ID format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot ID from the AdSense dashboard
NEXT_PUBLIC_ADSENSE_SLOT=
